<?xml version="1.0" encoding="utf-8"?>
<!-- Back up drawings and settings, and carry them to a new phone (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="art/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="art/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
